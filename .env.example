# Enables AI search (OpenRouter is used when set). Without a key, search falls back to keyword matching.
OPENROUTER_API_KEY=
# Or use the Anthropic API directly instead:
# ANTHROPIC_API_KEY=
# Optional
# WAITRO_MODEL=~deepseek/deepseek-flash-latest
# WAITRO_EFFORT=low
# WAITRO_AI_PER_IP_PER_HOUR=20
# WAITRO_AI_PER_DAY=1000
# WAITRO_CACHE_DAYS=7
